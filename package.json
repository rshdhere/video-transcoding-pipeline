{
  "name": "video-transcoding-pipeline",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "bun run db:migrate && turbo run dev --filter=@vtp/server --filter=@vtp/workers --filter=web",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test:integration": "turbo run test --filter=@vtp/integration",
    "db:generate": "turbo run db:generate --filter=@vtp/drizzle",
    "db:migrate": "turbo run db:migrate --filter=@vtp/drizzle"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.16",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.2.3",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/api/*",
    "packages/services/*",
    "tooling/*",
    "tests/*"
  ]
}
