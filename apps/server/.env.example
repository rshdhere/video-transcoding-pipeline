DATABASE_URL=postgresql://vtp:vtp@localhost:5432/vtp
BETTER_AUTH_SECRET=replace-with-a-secret-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3001
SERVER_PORT=3001
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@mail.raashed.cloud
MAIL_ENABLED=true
REQUIRE_EMAIL_VERIFICATION=false
AWS_ENABLED=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
S3_ENDPOINT=http://localhost:4566
S3_FORCE_PATH_STYLE=true
S3_UPLOAD_BUCKET=vtp-uploads
S3_TRANSCODED_BUCKET=vtp-transcoded
UPLOAD_PRESIGNED_URL_EXPIRES_SECONDS=3600
DOWNLOAD_PRESIGNED_URL_EXPIRES_SECONDS=3600
SQS_ENDPOINT=http://localhost:4566
SQS_TRANSCODING_QUEUE_URL=http://localhost:4566/000000000000/vtp-transcoding
SQS_EMAIL_VERIFICATION_QUEUE_URL=http://localhost:4566/000000000000/vtp-email-verification
